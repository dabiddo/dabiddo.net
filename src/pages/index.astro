---
import Layout from "../layouts/BasicLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsPerPage = 20;
const totalPages = Math.ceil(posts.length / postsPerPage);
const currentPage = 1;
const currentPosts = posts.slice(0, postsPerPage);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="home-posts">
    <p class="section-title">LATEST POSTS:</p>
    <ul>
      {currentPosts.map((post) => (
        <li>
          <span class="bullet">-</span>
          <a href={`/blog/${post.id}`} class="post-title">
            {post.data.title}
          </a>
          <span class="post-date">
            <FormattedDate date={post.data.pubDate} />
          </span>
        </li>
      ))}
    </ul>
    
    {totalPages > 1 && (
    <nav class="pagination">
        <span class="disabled-btn">&lt;&lt;_PREV_PAGE</span>
        <span class="page-info">PAGE {currentPage} OF {totalPages}</span>
        <a href="/page/2" class="nav-btn">NEXT_PAGE_&gt;&gt;</a>
    </nav>
    )}
  </section>
</Layout>

<style>
  .home-posts {
    font-size: 0.9rem;
  }

  .section-title {
    font-weight: bold;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .home-posts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .home-posts li {
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .bullet {
    color: #737373;
  }

  .post-title {
    color: #38bdf8;
    text-decoration: underline;
  }

  .post-title:hover {
    opacity: 0.7;
  }

  .sponsored-badge {
    font-size: 0.65rem;
    background-color: #404040;
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    font-weight: bold;
    color: #e5e5e5;
  }

  .post-date {
    font-size: 0.8rem;
    color: #a3a3a3;
    margin-left: auto; /* Empuja la fecha hacia la derecha si hay espacio */
  }

  .see-all {
    margin-top: 1.5rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed #404040;
    font-size: 0.85rem;
    font-weight: bold;
  }

  .page-info {
    color: #a3a3a3;
    letter-spacing: 0.05em;
  }

  .nav-btn {
    color: #38bdf8;
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .nav-btn:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .disabled-btn {
    color: #525252;
    cursor: not-allowed;
  }
</style>