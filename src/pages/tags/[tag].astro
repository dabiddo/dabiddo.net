---
import { getCollection } from "astro:content";
import Layout from "../../layouts/BasicLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export const getUniqueTags = (posts) => {
    let tags: string[] = [];
    posts.forEach((post) => {
        if (post.data.tags) {
            tags = [...tags, ...post.data.tags]
                .filter(
                    (value: string, index: number, self: string[]) =>
                        self.indexOf(value) === index,
                );
        }
    });
    return tags;
};

export const getPostsByTag = (posts, tag: string) =>
    posts.filter((post) => post.data.tags && post.data.tags.includes(tag));

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    const tags = getUniqueTags(posts);
    return tags.map((tag) => {
        return {
            params: { tag },
            props: { tag },
        };
    });
}

const { tag } = Astro.props;
const posts = await getCollection("blog");
const tagPosts = getPostsByTag(posts, tag).sort(
    (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout title={`TAG: ${tag}`} description={`Posts tagged with ${tag}`}>
    <main class="terminal-body">
        <h3 class="section-title">[ TAGGED_WITH: {tag.toUpperCase()} ]</h3>
        
        <ul class="post-list">
            {
                tagPosts.map((post, idx) => (
                    <li>
                        <a href={`/blog/${post.id}/`} class="post-row">
                            <span class="post-index">{(idx + 1).toString().padStart(2, '0')}.</span>
                            <span class="post-title">{post.data.title.toUpperCase().replace(/\s+/g, '_')}</span>
                            <span class="post-spacer"></span>
                            <span class="post-date">
                                <FormattedDate date={post.data.pubDate} />
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="back-link-container">
            <a href="/" class="nav-btn">&lt;&lt;_BACK_TO_HOME</a>
        </div>
    </main>
</Layout>

<style>
  .terminal-body {
    font-size: 0.9rem;
  }

  .section-title {
    font-weight: bold;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    color: #ffffff;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    margin-bottom: 0.6rem;
  }

  .post-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
  }

  .post-index {
    color: #737373;
    font-size: 0.8rem;
  }

  .post-title {
    color: #38bdf8;
    text-decoration: underline;
  }

  .post-row:hover .post-title {
    opacity: 0.7;
  }

  .post-spacer {
    flex-grow: 1;
    border-bottom: 1px dotted #404040;
    margin: 0 0.5rem;
    opacity: 0.4;
  }

  .post-date {
    font-size: 0.8rem;
    color: #a3a3a3;
    white-space: nowrap;
  }

  .back-link-container {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed #404040;
  }

  .nav-btn {
    color: #38bdf8;
    text-decoration: none;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    font-weight: bold;
  }

  .nav-btn:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
</style>