---
import SEO from "../components/SEO.astro"
export interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <SEO title={title} description={description} />
        <title>{title}</title>
    </head>
    <body>
        <!-- Intro del blog personal -->
        <div class="top-banner">
            <div class="bio-content">
                <h1>Hello, I'm Dabiddo.</h1>
                <p>
                    I write about software development, backend and any other stuff that I find interesting.
                </p>
            </div>
            <hr class="banner-divider" />
        </div>

        <div class="site-container">
            <!-- Header con logo y navegación -->
            <header class="site-header">
                <div class="logo">
                    <pre
        class="ascii-logo">
██████   █████  ██████  ██ ██████  ██████   ██████  
██   ██ ██   ██ ██   ██ ██ ██   ██ ██   ██ ██    ██ 
██   ██ ███████ ██████  ██ ██   ██ ██   ██ ██    ██ 
██   ██ ██   ██ ██   ██ ██ ██   ██ ██   ██ ██    ██ 
██████  ██   ██ ██████  ██ ██████  ██████   ██████   
</pre>
                </div>
                <nav class="nav-links">
                    <a href="/">HOME</a>
                    <a href="/about">ABOUT</a>
                    <a href="/tags">TAGS</a>
                </nav>
            </header>

            <!-- Contenido principal dividido en 2 columnas -->
            <div class="main-layout">
                <main class="content-area">
                    <slot />
                </main>

                <aside class="sidebar">
                    <div class="sponsor-box">
                        <img src="https://media.publit.io/file/Yamazaki.png" alt="Sponsor image" class="sponsor-img" />
                    </div>
                </aside>
            </div>
        </div>
    </body>
</html>

<style is:global>
    body {
        background-color: #262626; /* Un tono oscuro más cercano al de la referencia */
        color: #d4d4d4;
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; /* Tipografía tipo código/minimalista */
    }

    a {
        color: #38bdf8;
        text-decoration: none;
    }

    a:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    .ascii-logo {
        font-size: 10px;
        line-height: 1;
    }

    .top-banner {
        max-width: 1100px;
        margin: 1.5rem auto 1rem;
        padding: 0 1rem;
        font-size: 0.85rem;
    }

    .top-banner a {
        color: #38bdf8;
        font-weight: bold;
    }

    .top-banner p {
        margin: 0.25rem 0 1rem 0;
        color: #a3a3a3;
    }

    .banner-divider {
        border: none;
        border-top: 1px solid #404040;
        margin-top: 1rem;
    }

    .site-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem 3rem 1rem;
    }

    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .nav-links {
        display: flex;
        gap: 1.25rem;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .nav-links a {
        color: #e5e5e5;
    }

    .search-bar-container {
        margin-bottom: 2rem;
    }

    .search-input {
        width: 100%;
        background-color: #1e1e1e;
        border: 1px solid #404040;
        color: #ffffff;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        font-family: inherit;
        box-sizing: border-box;
    }

    .main-layout {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 3rem;
    }

    @media (max-width: 768px) {
        .main-layout {
            grid-template-columns: 1fr;
        }
        .nav-links {
            display: none; /* Opcional para mobile */
        }
    }

    /* Estilos de la barra lateral (Sidebar) */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .sponsor-box {
        background-color: #2a2a2a;
        border: 1px solid #404040;
        padding: 1rem;
        position: relative;
    }

    .sponsor-tag {
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        color: #a3a3a3;
        display: block;
        margin-bottom: 0.5rem;
    }

    .sponsor-box h3 {
        font-size: 0.95rem;
        margin: 0 0 0.5rem 0;
        color: #ffffff;
    }

    .sponsor-box p {
        font-size: 0.8rem;
        margin: 0;
        color: #a3a3a3;
    }

    .sponsor-cta {
        border: 1px dashed #525252;
        background-color: transparent;
    }

    .sponsor-img {
        width: 100%;          /* Hace que la imagen ocupe todo el ancho de la caja */
        height: auto;         /* Mantiene la proporción original de la imagen */
        display: block;       /* Elimina espacios fantasma inferiores en elementos inline */
        border-radius: 2px;   /* Opcional: si quieres redondear ligeramente sus esquinas */
    }
</style>